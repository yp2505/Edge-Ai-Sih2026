CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
# Run ESP32 at 240 MHz instead of 160 MHz — cuts TFLite inference from ~363ms to ~240ms
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_MHZ=240
# Suppress legacy I2C deprecation warning (migration not needed for this project)
CONFIG_I2C_SUPPRESS_DEPRECATE_WARN=y
# ── mbedTLS AES-128-CTR (for audio stream encryption) ─────────────────
# Both are already enabled by default in ESP-IDF; listed here explicitly
# so the build fails visibly if someone disables them via menuconfig.
CONFIG_MBEDTLS_AES_C=y
CONFIG_MBEDTLS_CTR_DRBG_C=y
CONFIG_ESP_SYSTEM_USE_ECC_LIB=n   # Not needed — AES only

# ── Compiler Optimization ───────────────────────────────────────────────────
# Force compile for Performance (-O2) instead of Debug (-Og). 
# This heavily optimizes TensorFlow Lite and drops inference latency by ~30%
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=n
CONFIG_COMPILER_OPTIMIZATION_DEBUG=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=n
